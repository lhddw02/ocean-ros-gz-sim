<?xml version="1.0"?>
<!-- Original primitive geometry, GPL-3.0-or-later. Motor and controller
     parameters follow Gazebo's Apache-2.0 multicopter example; see MODEL_NOTES.md. -->
<sdf version="1.9">
  <model name="landing_drone">
    <self_collide>false</self_collide>
    <link name="base_link">
      <inertial>
        <mass>1.16</mass>
        <inertia><ixx>0.028</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.028</iyy><iyz>0</iyz><izz>0.048</izz></inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.26 0.18 0.10</size></box></geometry>
      </collision>
      <visual name="body">
        <geometry><box><size>0.26 0.18 0.10</size></box></geometry>
        <material><ambient>0.85 0.18 0.03 1</ambient><diffuse>1 0.22 0.04 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <visual name="front_mark">
        <pose>0.12 0 0.055 0 0 0</pose>
        <geometry><box><size>0.03 0.16 0.012</size></box></geometry>
        <material><ambient>0.1 1 0.25 1</ambient><diffuse>0.1 1 0.25 1</diffuse></material>
      </visual>
      <visual name="arm_a">
        <pose>0 0 0 0 0 0.7853981634</pose>
        <geometry><box><size>0.65 0.035 0.025</size></box></geometry>
        <material><ambient>0.08 0.09 0.1 1</ambient><diffuse>0.11 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="arm_b">
        <pose>0 0 0 0 0 -0.7853981634</pose>
        <geometry><box><size>0.65 0.035 0.025</size></box></geometry>
        <material><ambient>0.08 0.09 0.1 1</ambient><diffuse>0.11 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="camera_housing">
        <pose>0 0 -0.075 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.05</size></box></geometry>
        <material><ambient>0.02 0.02 0.025 1</ambient><diffuse>0.03 0.03 0.04 1</diffuse></material>
      </visual>
      <!-- Gazebo camera looks along local +X. Pitch +pi/2 points it down.
           Optical axes: right=-body Y, down=-body X, forward=-body Z. -->
      <sensor name="downward_camera" type="camera">
        <pose>0 0 -0.10 0 1.5707963267948966 0</pose>
        <always_on>true</always_on><update_rate>20</update_rate>
        <topic>/drone/camera/image_raw</topic>
        <gz_frame_id>drone_camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.8</horizontal_fov>
          <image><width>960</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.03</near><far>100</far></clip>
          <camera_info_topic>/drone/camera/camera_info</camera_info_topic>
        </camera>
        <visualize>false</visualize>
      </sensor>
      <visual name="leg_fl">
        <pose>0.3 0.3 -0.22 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.39</length></cylinder></geometry>
        <material><ambient>0.15 0.17 0.19 1</ambient><diffuse>0.2 0.22 0.24 1</diffuse></material>
      </visual>
      <visual name="foot_fl_visual">
        <pose>0.3 0.3 -0.425 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <collision name="foot_fl">
        <pose>0.3 0.3 -0.425 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient></bounce></surface>
      </collision>
      <visual name="leg_fr">
        <pose>0.3 -0.3 -0.22 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.39</length></cylinder></geometry>
        <material><ambient>0.15 0.17 0.19 1</ambient><diffuse>0.2 0.22 0.24 1</diffuse></material>
      </visual>
      <visual name="foot_fr_visual">
        <pose>0.3 -0.3 -0.425 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <collision name="foot_fr">
        <pose>0.3 -0.3 -0.425 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient></bounce></surface>
      </collision>
      <visual name="leg_rl">
        <pose>-0.3 0.3 -0.22 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.39</length></cylinder></geometry>
        <material><ambient>0.15 0.17 0.19 1</ambient><diffuse>0.2 0.22 0.24 1</diffuse></material>
      </visual>
      <visual name="foot_rl_visual">
        <pose>-0.3 0.3 -0.425 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <collision name="foot_rl">
        <pose>-0.3 0.3 -0.425 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient></bounce></surface>
      </collision>
      <visual name="leg_rr">
        <pose>-0.3 -0.3 -0.22 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.39</length></cylinder></geometry>
        <material><ambient>0.15 0.17 0.19 1</ambient><diffuse>0.2 0.22 0.24 1</diffuse></material>
      </visual>
      <visual name="foot_rr_visual">
        <pose>-0.3 -0.3 -0.425 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <collision name="foot_rr">
        <pose>-0.3 -0.3 -0.425 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient></bounce></surface>
      </collision>
      <!-- Harmonic publishes native scoped Contact topics; the ROS bridge
           combines all four feet into /drone/contacts. -->
      <sensor name="landing_contact_fl" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>foot_fl</collision></contact>
      </sensor>
      <sensor name="landing_contact_fr" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>foot_fr</collision></contact>
      </sensor>
      <sensor name="landing_contact_rl" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>foot_rl</collision></contact>
      </sensor>
      <sensor name="landing_contact_rr" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>foot_rr</collision></contact>
      </sensor>
    </link>
    <link name="rotor_0">
      <pose>0.23 0.23 0.045 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>0.00003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00003</iyy><iyz>0</iyz><izz>0.00006</izz></inertia></inertial>
      <visual name="propeller">
        <geometry><box><size>0.26 0.025 0.005</size></box></geometry>
        <material><ambient>0.025 0.025 0.03 1</ambient><diffuse>0.04 0.04 0.045 1</diffuse></material>
      </visual>
      <visual name="motor">
        <geometry><cylinder><radius>0.021</radius><length>0.028</length></cylinder></geometry>
        <material><ambient>0.16 0.18 0.2 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent><child>rotor_0</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0</damping></dynamics></axis>
    </joint>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone</robotNamespace>
      <jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant><momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>0</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <link name="rotor_1">
      <pose>-0.23 -0.23 0.045 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>0.00003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00003</iyy><iyz>0</iyz><izz>0.00006</izz></inertia></inertial>
      <visual name="propeller">
        <geometry><box><size>0.26 0.025 0.005</size></box></geometry>
        <material><ambient>0.025 0.025 0.03 1</ambient><diffuse>0.04 0.04 0.045 1</diffuse></material>
      </visual>
      <visual name="motor">
        <geometry><cylinder><radius>0.021</radius><length>0.028</length></cylinder></geometry>
        <material><ambient>0.16 0.18 0.2 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent><child>rotor_1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0</damping></dynamics></axis>
    </joint>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone</robotNamespace>
      <jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant><momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>1</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <link name="rotor_2">
      <pose>0.23 -0.23 0.045 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>0.00003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00003</iyy><iyz>0</iyz><izz>0.00006</izz></inertia></inertial>
      <visual name="propeller">
        <geometry><box><size>0.26 0.025 0.005</size></box></geometry>
        <material><ambient>0.025 0.025 0.03 1</ambient><diffuse>0.04 0.04 0.045 1</diffuse></material>
      </visual>
      <visual name="motor">
        <geometry><cylinder><radius>0.021</radius><length>0.028</length></cylinder></geometry>
        <material><ambient>0.16 0.18 0.2 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent><child>rotor_2</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0</damping></dynamics></axis>
    </joint>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone</robotNamespace>
      <jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant><momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>2</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <link name="rotor_3">
      <pose>-0.23 0.23 0.045 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>0.00003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00003</iyy><iyz>0</iyz><izz>0.00006</izz></inertia></inertial>
      <visual name="propeller">
        <geometry><box><size>0.26 0.025 0.005</size></box></geometry>
        <material><ambient>0.025 0.025 0.03 1</ambient><diffuse>0.04 0.04 0.045 1</diffuse></material>
      </visual>
      <visual name="motor">
        <geometry><cylinder><radius>0.021</radius><length>0.028</length></cylinder></geometry>
        <material><ambient>0.16 0.18 0.2 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent><child>rotor_3</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0</damping></dynamics></axis>
    </joint>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone</robotNamespace>
      <jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant><momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>3</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-control-system"
            name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>drone</robotNamespace>
      <commandSubTopic>cmd_vel</commandSubTopic><enableSubTopic>enable</enableSubTopic>
      <comLinkName>base_link</comLinkName>
      <velocityGain>2.7 2.7 2.7</velocityGain>
      <attitudeGain>2 3 0.15</attitudeGain>
      <angularRateGain>0.4 0.52 0.18</angularRateGain>
      <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>
      <maximumLinearVelocity>2 2 1</maximumLinearVelocity>
      <maximumAngularVelocity>1 1 1</maximumAngularVelocity>
      <rotorConfiguration>
        <rotor><jointName>rotor_0_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant><momentConstant>0.016</momentConstant>
          <direction>1</direction></rotor>
        <rotor><jointName>rotor_1_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant><momentConstant>0.016</momentConstant>
          <direction>1</direction></rotor>
        <rotor><jointName>rotor_2_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant><momentConstant>0.016</momentConstant>
          <direction>-1</direction></rotor>
        <rotor><jointName>rotor_3_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant><momentConstant>0.016</momentConstant>
          <direction>-1</direction></rotor>
      </rotorConfiguration>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose><publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>30</update_frequency>
      <topic>/drone/pose</topic>
    </plugin>
  </model>
</sdf>
