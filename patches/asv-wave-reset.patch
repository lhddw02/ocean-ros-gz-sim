+void WavesVisual::Reset(const UpdateInfo &_info,
+    EntityComponentManager &_ecm)
+{
+  // Gazebo restores the same ECM / entity identities and retains the Sensors
+  // rendering scene. Preserve this visual's GPU resources too: reconstruction
+  // would retrieve resident entity-named displacement textures and attempt to
+  // change their resolution, which Ogre2 rejects. PreUpdate rewinds shader / FFT
+  // time and restores configured wind defaults under the rendering mutex.
+  this->PreUpdate(_info, _ecm);
