+
+struct WavesVisualOwnerKeyLess
+{
+  bool operator()(const WavesVisualOwnerKey &_a,
+      const WavesVisualOwnerKey &_b) const
+  {
+    return _a.first == _b.first ? _a.second < _b.second :
+        std::less<const EntityComponentManager *>{}(_a.first, _b.first);
+  }
+};
+
+std::mutex wavesVisualOwnersMutex;
