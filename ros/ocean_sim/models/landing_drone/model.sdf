<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="landing_drone">
    <self_collide>false</self_collide>
    <link name="base_link">
      <inertial>
        <mass>1.16</mass>
        <inertia>
          <ixx>0.028</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.028</iyy>
          <iyz>0</iyz>
          <izz>0.048</izz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.26 0.18 0.10</size>
          </box>
        </geometry>
      </collision>
      <sensor name="downward_camera" type="camera">
        <pose>0 0 -0.10 0 1.5707963267948966 0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/drone/camera/image_raw</topic>
        <gz_frame_id>drone_camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.8</horizontal_fov>
          <image>
            <width>960</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.03</near>
            <far>100</far>
          </clip>
          <camera_info_topic>/drone/camera/camera_info</camera_info_topic>
        </camera>
        <visualize>false</visualize>
      </sensor>
      <collision name="foot_fl">
        <pose>0.3 0.3 -0.425 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
          </bounce>
        </surface>
      </collision>
      <collision name="foot_fr">
        <pose>0.3 -0.3 -0.425 0 0 0</pose>
        <geometry>
