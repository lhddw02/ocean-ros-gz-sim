<?xml version="1.0"?>
<!-- Adapted from ASV Wave Sim's spherical_buoy at the pinned commit; GPL-3.0-or-later. -->
<sdf version="1.9">
  <model name="spherical_buoy">
    <plugin filename="gz-waves1-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics"/>
    <!-- SceneBroadcaster's compact pose stream may omit entity names. Publish
         this model separately so the smoke test never guesses a pose index. -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
      <topic>/ocean/buoy/pose</topic>
    </plugin>
    <link name="base_link">
      <visual name="visual">
        <geometry><sphere><radius>0.25</radius></sphere></geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry><sphere><radius>0.25</radius></sphere></geometry>
      </collision>
      <inertial>
        <mass>6.545</mass>
        <inertia>
          <ixx>0.1636</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.1636</iyy><iyz>0</iyz><izz>0.1636</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
