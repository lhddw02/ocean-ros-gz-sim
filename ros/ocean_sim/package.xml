<?xml version="1.0"?>
<package format="3">
  <name>ocean_sim</name>
  <version>0.1.0</version>
  <description>FFT ocean waves and floating objects for ROS 2 Humble and Gazebo Harmonic.</description>
  <maintainer email="maintainer@example.com">Ocean simulation maintainers</maintainer>
  <license>GPL-3.0-or-later</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ocean_station_systems</exec_depend>
  <exec_depend>ocean_landing_gui</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
